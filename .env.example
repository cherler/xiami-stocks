# ── 模型 ──
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# ── 接入虾米伙伴的积分账户 ──
#
# 留空 = 本地单机模式：AI 功能照常可用，一律不计费，页面上会如实标注「未接入积分」。
# 填了才会走闸口：调用前按最坏情况冻结，调用后按真实 token 结算，多冻的自动退。
#
# XM_API_BASE 指向主站后端（本地 http://127.0.0.1:8200，线上 http://127.0.0.1:8200 同机内网）。
XM_API_BASE=

# 后台任务（夜间同步、定时分级）没有用户 Cookie，只能走内网密钥这条路。
# 两个都要填才生效；XM_INTERNAL_KEY 必须与主站 .env 的 MODULE_INTERNAL_KEY 同值。
# XM_OWNER_USER_ID 是「这些定时任务算谁的账」——填你自己的 user_id。
XM_INTERNAL_KEY=
XM_OWNER_USER_ID=

# 本模块在主站账本里的名字。倍率在**主站** .env 的 STOCKS_CREDIT_MULTIPLIER 里调，
# 不在这里——计价的真源只有一处，子应用只上报 token 数，改不动价。
XM_CREDIT_MODULE=stocks

# ── 数据库后端 ──
# 留空/sqlite = 单文件本地库（默认，拷走就能带走）
# postgres    = 虾米伙伴主站库的 stocks schema（与账号、积分同库）
# 切之前先跑：python scripts/migrate_to_pg.py
STOCK_DB_BACKEND=sqlite
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=xiamimate
PG_USER=xiamimate
PG_PASSWORD=
STOCK_PG_SCHEMA=stocks
