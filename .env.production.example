# 虾米看股 · 服务器 .env 样板。真实文件放 /srv/<your-app>/.env，不进 Git。
#
# ⚠️ 不要直接拷本机的 .env 上来：本机是 STOCK_ACCESS=open（不校验身份）。
#    unit 文件里已强制 STOCK_ACCESS=owner 兜底，但正确姿势是照这份填。

# ── 模型 ──
MINIMAX_API_KEY=                 # ★ 必填
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# ── 接入虾米伙伴 ──
XM_API_BASE=http://127.0.0.1:8200
# 后台任务（夜间同步、定时分级）扣谁的积分。与主站 .env 的 MODULE_INTERNAL_KEY 同值才生效。
XM_INTERNAL_KEY=
XM_OWNER_USER_ID=                # 你在主站的 user_id
XM_CREDIT_MODULE=stocks

# ── 访问控制 ──
# multi = 任何登录用户可用，数据按用户隔离；下面名单里的管理员落在存量数据域。
# owner = 只允许管理员登录（想彻底关门时用）。unit 里已写死 multi 兜底。
STOCK_ACCESS=multi
STOCK_OWNER_EMAILS=you@example.com

# ── 数据库 ──
# 线上用 RDS PG 的 stocks schema（与主站账号/积分同库）。
# 数据来源：本地 PG → pg_dump -n stocks → psql 灌进 RDS（见 wiki/09）。
STOCK_DB_BACKEND=postgres
PG_HOST=                      # RDS 内网地址（与主站后端 .env 相同）
PG_PORT=5432
PG_DB=xiamimate
PG_USER=
PG_PASSWORD=
